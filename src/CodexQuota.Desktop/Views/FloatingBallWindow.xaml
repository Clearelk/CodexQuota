<Window x:Class="CodexQuota.Desktop.Views.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CodexQuota.Desktop.Views"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{DynamicResource Text.QuotaTitle}"
        Width="72"
        Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        FocusVisualStyle="{x:Null}"
        KeyDown="OnBallKeyDown">
  <Grid x:Name="LayoutRoot">
    <Viewbox x:Name="BallHost" Stretch="Uniform">
      <Grid x:Name="RootGrid" Width="72" Height="72" Background="{x:Null}">
        <Ellipse x:Name="Ball"
                 Width="72"
                 Height="72"
                 Fill="{Binding BallSurfaceBrush}"
                 Stroke="{Binding BallBorderBrush}" StrokeThickness="1"
                 ToolTip="{Binding TooltipText}"
                 ToolTipService.InitialShowDelay="900"
                 ToolTipService.Placement="Top"
                 AutomationProperties.Name="{DynamicResource Text.BallAccessible}"
                 MouseEnter="OnBallMouseEnter"
                 MouseLeave="OnBallMouseLeave"
                 MouseLeftButtonDown="OnBallMouseDown"
                 MouseMove="OnBallMouseMove"
                 MouseLeftButtonUp="OnBallMouseUp"
                 MouseRightButtonUp="OnBallMouseRightUp">
          <Ellipse.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{DynamicResource Text.Details}" Click="OnMenuDetails" />
              <MenuItem Header="{DynamicResource Text.RefreshNow}" Click="OnMenuRefresh" />
              <MenuItem Header="{DynamicResource Text.Settings}" Click="OnMenuSettings" />
              <MenuItem Header="{DynamicResource Text.Exit}" Click="OnMenuExit" />
            </ContextMenu>
          </Ellipse.ContextMenu>
        </Ellipse>

        <!-- The percentage, ring and inline health row are presentation only. The ellipse
             owns the complete floating surface's capture, click and context-menu events. -->
        <views:ProgressRing x:Name="Ring"
                            Width="64"
                            Height="64"
                            RingThickness="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Value="{Binding BallRemainingPercent, Mode=OneWay}"
                            HasValue="{Binding BallHasValue, Mode=OneWay}"
                            TrackBrush="{Binding BallRingTrackBrush}"
                            ArcBrush="{Binding BallRingBrush}" />

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
          <TextBlock Text="{Binding BallText}"
                     Foreground="{Binding BallTextBrush}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Codex"
                     Foreground="{Binding BallMutedTextBrush}"
                     FontSize="8"
                     HorizontalAlignment="Center"
                     Margin="0,-1,0,0" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center" Margin="0,1,0,0">
            <Ellipse x:Name="StatusDot" Width="6" Height="6"
                     Fill="{Binding BallDotBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="BallPeriodLabel" Text="{Binding BallPeriodText}"
                       Foreground="{Binding BallMutedTextBrush}" FontSize="8"
                       Margin="3,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding BallPeriodVisible, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Viewbox>

    <!-- Deliberate side-edge docking: an inset quota capsule with a wider transparent hit
         lane on the same HWND. Visible only while a canonical dock exists; the lane
         stays hit-testable during the inward reveal so the stationary pointer cannot
         synthesize a leave that would immediately recollapse. -->
    <Border x:Name="DockStrip"
            Background="#03000000"
            Visibility="Collapsed"
            Focusable="True"
            FocusVisualStyle="{x:Null}"
            AutomationProperties.Name="{DynamicResource Text.DockAccessible}"
            MouseEnter="OnDockStripMouseEnter"
            MouseLeave="OnDockStripMouseLeave"
            MouseLeftButtonDown="OnDockStripMouseDown"
            MouseMove="OnDockStripMouseMove"
            MouseLeftButtonUp="OnDockStripMouseUp"
            MouseRightButtonUp="OnDockStripMouseRightUp"
            KeyDown="OnBallKeyDown">
      <views:QuotaCapsule x:Name="DockStripAccent"
                          Width="14"
                          Fraction="{Binding BallRemainingFraction, Mode=OneWay}"
                          ShellBrush="{DynamicResource DockStripShellBrush}"
                          BorderBrush="{DynamicResource DockStripBorderBrush}"
                          TrackBrush="{DynamicResource DockStripTrackBrush}"
                          FillBrush="{Binding DockStripFillBrush}"
                          IsHitTestVisible="False"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch" />
    </Border>
  </Grid>
</Window>
