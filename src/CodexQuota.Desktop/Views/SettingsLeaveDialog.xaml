<Window x:Class="CodexQuota.Desktop.Views.SettingsLeaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.UnsavedTitle}"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        AutomationProperties.Name="{DynamicResource Text.UnsavedTitle}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Settings.xaml" /></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Style="{StaticResource WidgetRoot}" CornerRadius="14">
    <StackPanel Margin="16,16,16,14">
      <Grid MinHeight="62">
        <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.RowSpan="2" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
          <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.11" />
          <Path Data="M12,4 L12,20 M12,27 L12,27.2" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Grid.Column="1" Text="{DynamicResource Text.UnsavedTitle}" Style="{StaticResource TitleText}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0" />
        <TextBlock Grid.Column="1" Grid.Row="1" Text="{DynamicResource Text.UnsavedDescription}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource Text.UnsavedAccessible}" />
        <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource CloseButton}" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Click="OnContinue" ToolTip="{DynamicResource Text.ContinueEditing}" AutomationProperties.Name="{DynamicResource Text.CloseConfirmation}">
          <Path Data="{StaticResource CloseIcon}" Style="{StaticResource OutlineIcon}" Width="12" Height="12" />
        </Button>
      </Grid>
      <Border Style="{StaticResource SettingsDivider}" Margin="0,10,0,12" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button x:Name="SaveAndLeaveButton" Content="{DynamicResource Text.SaveAndLeave}" Style="{StaticResource SettingsPrimaryButton}" Height="32" FontSize="12" Padding="8,5" Click="OnSaveAndLeave" AutomationProperties.Name="{DynamicResource Text.SaveAndLeave}" />
        <Button x:Name="DiscardAndLeaveButton" Grid.Column="2" Content="{DynamicResource Text.DiscardAndLeave}" Style="{StaticResource SettingsSecondaryButton}" Height="32" FontSize="12" Padding="8,5" BorderThickness="0" Background="{DynamicResource ButtonSurfaceBrush}" Click="OnDiscardAndLeave" AutomationProperties.Name="{DynamicResource Text.DiscardAndLeave}" />
        <Button x:Name="ContinueButton" Grid.Column="4" Content="{DynamicResource Text.ContinueEditing}" Style="{StaticResource SettingsContinueButton}" Height="32" FontSize="12" Padding="8,5" Click="OnContinue" AutomationProperties.Name="{DynamicResource Text.ContinueEditing}" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
