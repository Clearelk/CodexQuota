<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CodexQuota.Desktop</RootNamespace>
    <AssemblyName>CodexQuota.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>CodexQuota.Desktop.App</StartupObject>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- WPF ships an unrelated experimental System.Windows.ThemeMode; an alias keeps the domain type unambiguous. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is used for the tray icon only, so its implicit usings must not shadow WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.Design" />
    <Using Include="CodexQuota.Core.Models.ThemeMode" Alias="ThemeMode" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexQuota.Core\CodexQuota.Core.csproj" />
  </ItemGroup>

</Project>
