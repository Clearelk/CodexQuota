<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Window-local overrides: Details retains the shared compact sizing policy. -->
  <sys:Double x:Key="PanelWidth">440</sys:Double>
  <sys:Double x:Key="SettingsPanelHeight">640</sys:Double>

  <!-- Settings keeps native focus and each control's template feedback without the default dotted adorner. -->
  <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control" /></Setter.Value></Setter>
  </Style>

  <Geometry x:Key="SettingsPowerIcon">M12,2 L12,11 M6,5 A9,9 0 1 0 18,5</Geometry>
  <Geometry x:Key="SettingsPaletteIcon">M12,2 C6.5,2 2,6.3 2,12 C2,17.5 6.3,22 11,22 C13,22 13.5,20.8 12.4,19.2 C11.2,17.5 12.4,15.5 14.5,15.5 L17,15.5 C20.5,15.5 22,13.8 22,11 C22,6 17.5,2 12,2 Z M7,9 L7,9.2 M11,6.5 L11,6.7 M16,7 L16,7.2 M18,11 L18,11.2</Geometry>
  <Geometry x:Key="SettingsBallIcon">M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2</Geometry>
  <Geometry x:Key="SettingsBellIcon">M5,9 C5,5 8,3 12,3 C16,3 19,5 19,9 L19,14 L22,18 L2,18 L5,14 Z M12,1 L12,3 M9,21 C10.5,23 13.5,23 15,21</Geometry>
  <Geometry x:Key="SettingsGlobeIcon">M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 M2,12 L22,12 M12,2 C5,7 5,17 12,22 C19,17 19,7 12,2</Geometry>
  <Geometry x:Key="SettingsDocumentIcon">M5,2 L14,2 L20,8 L20,22 L5,22 Z M14,2 L14,8 L20,8 M8,12 L16,12 M8,16 L16,16</Geometry>

  <Style x:Key="SettingsRow" TargetType="Grid"><Setter Property="MinHeight" Value="46" /></Style>
  <Style x:Key="SettingsRowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="13.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="SettingsDescription" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
    <Setter Property="FontSize" Value="11.5" /><Setter Property="Margin" Value="0,1,0,0" /><Setter Property="LineHeight" Value="16" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SettingsRowIcon" TargetType="Path" BasedOn="{StaticResource OutlineIcon}">
    <Setter Property="Width" Value="17" /><Setter Property="Height" Value="17" /><Setter Property="Margin" Value="0,0,9,0" />
  </Style>
  <Style x:Key="SettingsDivider" TargetType="Border">
    <Setter Property="Height" Value="1" /><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Opacity" Value="0.09" />
  </Style>
  <Style x:Key="SettingsCard" TargetType="GroupBox">
    <Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox">
      <Grid>
        <Border Background="{DynamicResource WindowSurfaceBrush}" CornerRadius="7" />
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="7" Opacity="0.16" IsHitTestVisible="False" />
        <StackPanel Margin="1">
          <Grid Height="28">
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="6,6,0,0" Opacity="0.07" />
            <ContentPresenter ContentSource="Header" Margin="12,0" VerticalAlignment="Center" TextBlock.FontSize="14" TextBlock.FontWeight="SemiBold" />
          </Grid>
          <ContentPresenter Margin="12,0" />
        </StackPanel>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsSelector" TargetType="ComboBox" BasedOn="{StaticResource PanelComboBox}">
    <Setter Property="Width" Value="138" /><Setter Property="Height" Value="30" /><Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="SettingsToggle" TargetType="CheckBox" BasedOn="{StaticResource SettingToggle}">
    <Setter Property="Width" Value="44" /><Setter Property="Height" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Keep native Track/Thumb commands and the full-height transparent input strip. -->
  <Style x:Key="SettingsSlider" TargetType="Slider" BasedOn="{StaticResource ReferenceSlider}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Background="Transparent">
        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackButton}" Background="{DynamicResource AccentBrush}" Command="{x:Static Slider.DecreaseLarge}" /></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackButton}" Background="{DynamicResource ProgressTrackBrush}" Command="{x:Static Slider.IncreaseLarge}" /></Track.IncreaseRepeatButton>
          <Track.Thumb>
            <Thumb Width="20" Height="28"><Thumb.Template><ControlTemplate TargetType="Thumb">
              <Grid Background="Transparent"><Ellipse x:Name="Knob" Width="18" Height="18" Fill="{DynamicResource WindowSurfaceBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" /></Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="StrokeThickness" Value="2" /></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="StrokeThickness" Value="2" /></Trigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="True"><Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource FocusBrush}" /><Setter TargetName="Knob" Property="StrokeThickness" Value="2" /></DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Thumb.Template></Thumb>
          </Track.Thumb>
        </Track>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="FontSize" Value="13" /><Setter Property="Height" Value="34" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SettingsSecondaryButton" TargetType="Button" BasedOn="{StaticResource SettingsPrimaryButton}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style x:Key="SettingsContinueButton" TargetType="Button" BasedOn="{StaticResource SettingsSecondaryButton}">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource WindowSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
</ResourceDictionary>
